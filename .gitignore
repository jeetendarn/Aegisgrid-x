cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Environment
.env
.env.*
!.env.example

# FastAPI
*.log

# Node
node_modules/
dist/
build/
.npm/
.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-data/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Kubernetes
*.secret.yaml

# Temporary
tmp/
temp/
*.tmp
EOF